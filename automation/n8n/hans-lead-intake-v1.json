{
  "name": "SirHansFelix Lead Intake v1",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "hans-leads",
        "responseMode": "responseNode",
        "options": {}
      },
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "id": "webhook-hans",
      "name": "Receive Website Lead"
    },
    {
      "parameters": {
        "jsCode": "\nconst raw = $json.body ?? $json;\nconst lead = typeof raw === 'string' ? JSON.parse(raw) : raw;\nconst now = new Date();\nconst score = Number(lead.leadScore != null ? lead.leadScore : 0);\nconst isQualified = score >= 7;\n\nreturn [{\n  json: {\n    ...lead,\n    leadScore: score,\n    qualificationStatus: isQualified ? 'Qualified' : 'Nurture',\n    status: isQualified ? 'Qualified' : 'Nurture',\n    emailStatus: 'Pending',\n    bookingStatus: isQualified ? 'Invited' : 'Not Invited',\n    followUpStage: isQualified ? '0' : 'Complete',\n    nextFollowUpAt: isQualified ? new Date(now.getTime() + 86400000).toISOString() : '',\n    lastContactedAt: '',\n    stoppedReason: isQualified ? '' : 'Nurture',\n    appointmentStart: '',\n    appointmentEventId: '',\n    receivedAt: now.toISOString()\n  }\n}];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "id": "code-state",
      "name": "Initialize Revenue State"
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "value": "1-FeERbZmWeEP1dkHw2wL-bOvTrvTctAoVKbTuwqsjis",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Applications",
          "mode": "name"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "submittedAt": "={{ $json.submittedAt || $json.receivedAt }}",
            "source": "={{ $json.source }}",
            "leadScore": "={{ $json.leadScore }}",
            "name": "={{ $json.name }}",
            "email": "={{ $json.email }}",
            "contactHandle": "={{ $json.contactHandle }}",
            "experience": "={{ $json.experience }}",
            "market": "={{ $json.market }}",
            "interest": "={{ $json.interest }}",
            "problem": "={{ $json.problem }}",
            "nextStep": "={{ $json.nextStep }}",
            "chosenPlan": "={{ $json.chosenPlan || 'None selected' }}",
            "status": "={{ $json.qualificationStatus }}",
            "qualificationStatus": "={{ $json.qualificationStatus }}",
            "emailStatus": "={{ $json.emailStatus || 'Pending' }}",
            "bookingStatus": "={{ $json.bookingStatus || ($json.qualificationStatus === 'Qualified' ? 'Invited' : 'Not Invited') }}",
            "followUpStage": "={{ $json.followUpStage || ($json.qualificationStatus === 'Qualified' ? '0' : 'Complete') }}",
            "nextFollowUpAt": "={{ $json.nextFollowUpAt || '' }}",
            "lastContactedAt": "={{ $json.lastContactedAt || '' }}",
            "stoppedReason": "={{ $json.stoppedReason || ($json.qualificationStatus === 'Qualified' ? '' : 'Nurture') }}",
            "appointmentStart": "={{ $json.appointmentStart || '' }}",
            "reminder24hSent": "",
            "reminder1hSent": "",
            "attendanceStatus": "",
            "postCallFollowUpSent": "",
            "postCallFollowUpAt": ""
          },
          "matchingColumns": [],
          "schema": []
        },
        "options": {}
      },
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.6,
