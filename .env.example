# ── LEAD AUTOMATION ────────────────────────────────────────────────────────────
# LEAD_WEBHOOK_URL: The n8n production webhook that receives qualified applications.
# Format: https://[your-n8n-instance]/webhook/hans-leads
# Set this in Vercel → Project → Settings → Environment Variables.
# Never prefix with VITE_ — that would expose it in the browser.
LEAD_WEBHOOK_URL="https://your-n8n.example/webhook/hans-leads"

# ── RATE LIMITING (optional but recommended for production) ────────────────────
# Get these from: upstash.com → your Redis database → REST API section.
# If both are empty, rate limiting is silently skipped (safe for local dev).
UPSTASH_REDIS_REST_URL="https://YOUR-DB.upstash.io"
UPSTASH_REDIS_REST_TOKEN="AX..."

# ── CORS (optional) ───────────────────────────────────────────────────────────
# Comma-separated list of allowed request origins.
# If empty or unset, origin check is skipped (safe for local dev and Vercel previews).
# Example: https://sirhansfelix.com,https://sirhansfelix-praxis.vercel.app
ALLOWED_ORIGINS=""

# ── AI STUDIO INJECTED (do not edit manually) ─────────────────────────────────
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
